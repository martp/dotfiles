# ~/.zshrc
# Clean setup — no Oh My Zsh

# ─── Homebrew ───────────────────────────────────────────────
eval "$(/opt/homebrew/bin/brew shellenv)"

# ─── Starship prompt ────────────────────────────────────────
eval "$(starship init zsh)"

# ─── zsh plugins ────────────────────────────────────────────
source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$HOME/.zsh/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"
source "$(brew --prefix)/share/zsh-you-should-use/you-should-use.plugin.zsh"

# ─── fzf (Ctrl+R history search) ────────────────────────────
eval "$(fzf --zsh)"

# ─── zoxide (smart cd) ──────────────────────────────────────
eval "$(zoxide init zsh)"

# ─── fnm (Node version manager) ─────────────────────────────
eval "$(fnm env --use-on-cd --shell zsh)"

# ─── Modern CLI aliases ──────────────────────────────────────
alias ls="eza --icons --group-directories-first"
alias ll="eza -la --icons --group-directories-first --git"
alias lt="eza --tree --icons --level=2"
alias cat="bat --paging=never"
# Note: fd and rg are available directly — not aliased over find/grep
# to avoid breaking scripts that rely on POSIX flag conventions

# ─── Git aliases ────────────────────────────────────────────

# Rebase current branch onto the default remote branch (main/master)
alias gru='git fetch origin && git rebase origin/$(git symbolic-ref refs/remotes/origin/HEAD | sed "s@^refs/remotes/origin/@@")'

# Merge the latest default branch (main/master) into the current branch
alias gmu='git fetch origin && git merge origin/$(git symbolic-ref refs/remotes/origin/HEAD | sed "s@^refs/remotes/origin/@@")'

alias gs="git status"
alias gaa="git add --all"
alias gcm="git commit -m"
alias gcam="git commit -a -m"
alias gp="git push"
alias gl="git pull"
alias gco="git checkout"
alias gcb="git checkout -b"

# ─── Bun shortcuts ──────────────────────────────────────────
alias bi="bun install"
alias ba="bun add"
# Note: dev/build intentionally omitted — too generic, add per-project in ~/.zshrc.local

# ─── Editor ─────────────────────────────────────────────────
export EDITOR="code"

# ─── History ────────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE

# ─── Up/down arrow: prefix-aware history search ─────────────
autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search
bindkey "^[[B" down-line-or-beginning-search

# ─── PATH ───────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$PATH"

# ─── Local overrides (machine/client-specific, not in git) ──
# Put API keys, work aliases, client PATH entries etc. in ~/.zshrc.local
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
